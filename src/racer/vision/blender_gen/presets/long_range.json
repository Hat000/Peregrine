{
  "name": "long_range",
  "description": "The co-visibility tail: gates 15-30 m out where the inner square is small and the next-gate sighting drives the gate-relative estimator. Trains the small-target regime that feeds terminal gate-lock.",
  "viewpoint": {
    "range_min_m": 15.0,
    "range_max_m": 30.0,
    "range_skew": 1.0,
    "lateral_sigma_m": 1.6,
    "vertical_sigma_m": 1.2,
    "yaw_jitter_rad": 0.25,
    "pitch_jitter_rad": 0.2,
    "roll_jitter_rad": 0.3
  },
  "augment": {
    "enable": true,
    "photometric_p": 0.85,
    "lighting_p": 0.5,
    "brightness_p": 0.6,
    "geometric_p": 0.1
  },
  "appearance": {
    "use_vq1_red": true,
    "gate_hue_jitter": 0.45,
    "gate_sat_range": [0.4, 1.0],
    "gate_val_range": [0.5, 1.0],
    "sun_elevation_range_deg": [15.0, 80.0],
    "sun_intensity_range": [1.5, 6.0],
    "color_temp_range_k": [4500.0, 7500.0],
    "use_hdri": true,
    "hdri_dir": null,
    "background_mode": "mixed",
    "clutter_max": 8,
    "floor_wall_texture_prob": 0.6
  },
  "render": {
    "engine": "CYCLES",
    "samples": 112,
    "use_gpu": true,
    "use_denoise": true,
    "motion_blur": true,
    "motion_blur_shutter": 0.4,
    "use_glare": true
  }
}
