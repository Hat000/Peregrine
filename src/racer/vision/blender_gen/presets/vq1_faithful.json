{
  "name": "vq1_faithful",
  "description": "The VQ1 floor: extracted orange-red gates, arena lighting, light sensor aug. Reproduces the look the inc7 detector already handles -- the regression anchor / lower bound.",
  "viewpoint": {
    "range_min_m": 2.0,
    "range_max_m": 30.0,
    "range_skew": 2.0,
    "lateral_sigma_m": 1.0,
    "vertical_sigma_m": 0.7,
    "yaw_jitter_rad": 0.25,
    "pitch_jitter_rad": 0.2,
    "roll_jitter_rad": 0.3
  },
  "augment": {
    "enable": true,
    "photometric_p": 0.6,
    "lighting_p": 0.2,
    "brightness_p": 0.4,
    "geometric_p": 0.0
  },
  "appearance": {
    "use_vq1_red": true,
    "gate_hue_jitter": 0.0,
    "gate_sat_range": [0.9, 1.0],
    "gate_val_range": [0.85, 1.0],
    "gate_metallic_range": [0.0, 0.2],
    "gate_roughness_range": [0.3, 0.6],
    "sun_elevation_range_deg": [30.0, 70.0],
    "sun_intensity_range": [2.0, 5.0],
    "color_temp_range_k": [5500.0, 6500.0],
    "use_hdri": false,
    "background_mode": "arena",
    "clutter_max": 4,
    "floor_wall_texture_prob": 0.3
  },
  "render": {
    "engine": "CYCLES",
    "samples": 96,
    "use_gpu": true,
    "use_denoise": true,
    "motion_blur": true,
    "motion_blur_shutter": 0.4,
    "use_glare": true
  }
}
