{
  "name": "vq1_faithful",
  "description": "The VQ1 floor: extracted orange-red gates, arena lighting, light sensor aug. Reproduces the look the inc7 detector already handles -- the regression anchor / lower bound.",
  "viewpoint": {
    "range_min_m": 2.0,
    "range_max_m": 30.0,
    "range_skew": 2.0,
    "lateral_sigma_m": 1.0,
    "vertical_sigma_m": 0.7,
    "yaw_jitter_rad": 0.25,
    "pitch_jitter_rad": 0.2,
    "roll_jitter_rad": 0.3
  },
  "augment": {
    "enable": true,
    "photometric_p": 0.6,
    "lighting_p": 0.2,
    "brightness_p": 0.4,
    "geometric_p": 0.0
  },
  "appearance": {
    "use_vq1_red": true,
    "gate_hue_jitter": 0.0,
    "gate_sat_range": [0.9, 1.0],
    "gate_val_range": [0.85, 1.0],
    "gate_metallic_range": [0.0, 0.2],
    "gate_roughness_range": [0.3, 0.6],
    "use_hdri": true,
    "photoreal": true,
    "gate_emission_range": [0.25, 0.5],
    "prop_count_range": [8, 14],
    "people_count_range": [2, 5],
    "exposure_range": [-0.4, 0.5]
  },
  "render": {
    "engine": "CYCLES",
    "samples": 160,
    "use_gpu": true,
    "use_denoise": true,
    "motion_blur": false,
    "use_glare": false
  }
}
