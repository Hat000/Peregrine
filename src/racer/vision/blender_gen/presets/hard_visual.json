{
  "name": "hard_visual",
  "description": "Robustness tail: dark-arena coloured spotlights, heavy lens flares, racing motion blur, occlusion/dropout, low light and overexposure (incl. spectator-flash-like blowouts), mild keypoint-aware geometric warp, plus ~25% embedded hard negatives. The chaos band the detector must not fall off.",
  "negative_fraction": 0.25,
  "viewpoint": {
    "range_min_m": 2.0,
    "range_max_m": 30.0,
    "range_skew": 2.0,
    "lateral_sigma_m": 1.6,
    "vertical_sigma_m": 1.1,
    "yaw_jitter_rad": 0.45,
    "pitch_jitter_rad": 0.4,
    "roll_jitter_rad": 0.6,
    "speed_min_mps": 12.0,
    "speed_max_mps": 35.0
  },
  "augment": {
    "enable": true,
    "photometric_p": 0.95,
    "lighting_p": 0.8,
    "brightness_p": 0.7,
    "geometric_p": 0.35,
    "geometric_rotate_deg": 10.0,
    "perspective_scale": 0.06,
    "motion_blur_limit": 25,
    "jpeg_quality_min": 18,
    "jpeg_quality_max": 55
  },
  "appearance": {
    "use_vq1_red": false,
    "gate_hue_jitter": 0.5,
    "gate_sat_range": [0.2, 1.0],
    "gate_val_range": [0.3, 1.0],
    "gate_metallic_range": [0.0, 0.7],
    "gate_roughness_range": [0.1, 0.9],
    "lighting_mode": "dark_arena",
    "ambient_strength_range": [0.05, 1.0],
    "n_spotlights_range": [1, 4],
    "spotlight_energy_range": [200.0, 4000.0],
    "colored_light_prob": 0.5,
    "sun_elevation_range_deg": [5.0, 88.0],
    "sun_intensity_range": [0.5, 9.0],
    "color_temp_range_k": [3500.0, 9000.0],
    "use_hdri": true,
    "hdri_dir": null,
    "background_mode": "mixed",
    "clutter_max": 10,
    "floor_wall_texture_prob": 0.8,
    "exposure_range": [-1.2, 1.2],
    "gamma_range": [0.8, 1.2],
    "sensor_noise_prob": 0.6
  },
  "render": {
    "engine": "CYCLES",
    "samples": 80,
    "use_gpu": true,
    "use_denoise": true,
    "motion_blur": true,
    "motion_blur_shutter": 0.8,
    "use_glare": true
  }
}
