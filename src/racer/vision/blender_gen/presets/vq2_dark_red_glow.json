{
  "name": "vq2_dark_red_glow",
  "description": "The FIXED VQ2 'Now You See Me' look: glowing orange-red gates in a DARK warehouse (scene mean gray ~36). Legacy dark_arena path (NOT photoreal/HDRI, which is bright). Gate colour anchored at VQ1 orange-red (no hue jitter), always self-lit (emission_prob=1). Low world ambient + a couple of hard spots. Match ONE appearance per APPEARANCE_SPEC, do not broadly domain-randomize.",
  "negative_fraction": 0.0,
  "viewpoint": {
    "range_min_m": 2.0,
    "range_max_m": 30.0,
    "range_skew": 2.0,
    "lateral_sigma_m": 1.0,
    "vertical_sigma_m": 0.7,
    "yaw_jitter_rad": 0.25,
    "pitch_jitter_rad": 0.2,
    "roll_jitter_rad": 0.3
  },
  "augment": {
    "enable": true,
    "photometric_p": 0.5,
    "lighting_p": 0.15,
    "brightness_p": 0.35,
    "geometric_p": 0.0
  },
  "appearance": {
    "use_vq1_red": true,
    "gate_hue_jitter": 0.0,
    "gate_sat_range": [0.95, 1.0],
    "gate_val_range": [0.9, 1.0],
    "gate_metallic_range": [0.0, 0.1],
    "gate_roughness_range": [0.3, 0.6],
    "gate_emission_prob": 1.0,
    "photoreal": false,
    "lighting_mode": "dark_arena",
    "ambient_strength_range": [0.03, 0.06],
    "n_spotlights_range": [1, 3],
    "spotlight_energy_range": [200.0, 2000.0],
    "colored_light_prob": 0.15,
    "background_mode": "arena",
    "clutter_max": 6,
    "floor_wall_texture_prob": 0.5,
    "exposure_range": [-0.2, 0.2],
    "gamma_range": [0.95, 1.05],
    "sensor_noise_prob": 0.3
  },
  "render": {
    "engine": "CYCLES",
    "samples": 96,
    "use_gpu": true,
    "use_denoise": true,
    "motion_blur": false,
    "use_glare": true
  }
}
