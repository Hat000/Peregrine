+            reg = _regime_of(seeker, int(s.sim_time_ns), seeker._last_pose) if _diag_path else ""
+            print(f"  t={s.sim_time_ns/1e9:7.2f}s gi={gate_index} [{reg}] "
                   f"thr={cmd.thrust:.3f} rate=[{br[0]:+.2f},{br[1]:+.2f},{br[2]:+.2f}] "
-                  f"tsv={nav_state.time_since_vision_update_s:.2f}s   ",
+                  f"estP={nav_state.pitch:+.2f} tsv={nav_state.time_since_vision_update_s:.2f}s "
+                  f"navMs={_nav_ms:.0f}   ",
                   end="\r", flush=True)
             last_p = now
 
     if final_state == "IDLE":
         final_state = "TIMEOUT" if time.monotonic() >= deadline else "STALLED"
         print(f"\n  ({final_state.lower()})")
+    # DIAG: flush the buffered per-tick rows once (no per-tick disk I/O during flight).
+    if _diag_path and _diag_rows:
+        with open(_diag_path, "w") as _f:
+            _f.write("t_s,regime,anchored,pass_armed,passing,gi,consec_det,det_range_m,trk_range_m,"
+                     "trk_az,trk_el,est_roll,est_pitch,est_yaw,thr,cmd_roll_rps,cmd_pitch_rps,"
+                     "cmd_yaw_rps,tsv_s,tick_dt_ms,nav_ms\n")
+            for r in _diag_rows:
+                _f.write(",".join(f"{v:.4f}" if isinstance(v, float) else str(v) for v in r) + "\n")
+        _navs = [r[-1] for r in _diag_rows]
+        _dts = [r[-2] for r in _diag_rows[1:]]
